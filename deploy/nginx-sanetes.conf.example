# Adicione este bloco à configuração do container hexflow_nginx.
# Substitua sanetes.seudominio.com pelo domínio real e preserve a configuração
# de certificados que já é utilizada pelo seu Nginx/Certbot.

server {
    listen 80;
    server_name sanetes.seudominio.com;

    client_max_body_size 110m;

    location / {
        proxy_pass http://sanetes-web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
